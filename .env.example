# 服务端口
PORT=3000

# 百度翻译 API（免费标准版）
# 申请地址: https://fanyi-api.baidu.com/
BAIDU_TRANSLATE_APPID=你的AppID
BAIDU_TRANSLATE_SECRET=你的密钥

# 微信公众号推送
# 获取方式: 微信公众平台 mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_APPID=你的公众号AppID
WECHAT_SECRET=你的公众号AppSecret

# 数据库路径（可选，默认 ./data/health_news.db）
# DB_PATH=./data/health_news.db
