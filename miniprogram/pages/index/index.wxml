<!-- 首页 - 健康资讯列表 -->
<view class="container {{fontSize}}">
  <!-- 搜索栏 -->
  <view class="search-bar" bindtap="onSearch">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索健康资讯...</text>
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-nav" scroll-x enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-tab {{currentCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <text>{{item.icon}} {{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 今日推荐 -->
  <view wx:if="{{featured}}" class="featured-card" data-id="{{featured.id}}" bindtap="onArticleTap">
    <view class="featured-tag">今日推荐</view>
    <view class="featured-title">{{featured.title || featured.original_title}}</view>
    <view class="featured-summary">{{featured.summary}}</view>
    <view class="featured-meta">
      <text>{{featured.source_name}}</text>
      <text>{{featured.published_at}}</text>
    </view>
  </view>

  <!-- 文章列表 -->
  <view class="section-title">最新资讯</view>
  <view class="article-list">
    <view
      wx:for="{{articles}}"
      wx:key="id"
      wx:if="{{index > 0 || page > 1}}"
      class="article-card"
      data-id="{{item.id}}"
      bindtap="onArticleTap"
    >
      <view class="category-tag">{{item.category}}</view>
      <view class="article-title">{{item.title || item.original_title}}</view>
      <view class="article-summary">{{item.summary}}</view>
      <view class="meta-info">
        <text>{{item.source_name}} · {{item.published_at}}</text>
        <text class="stats">{{item.view_count}}阅读 · {{item.like_count}}赞</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{!hasMore && articles.length > 0}}" class="loading">没有更多了</view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && articles.length === 0}}" class="empty-state">
    <view class="empty-icon">📭</view>
    <view class="empty-text">暂无资讯内容</view>
    <view class="empty-hint">下拉刷新获取最新健康资讯</view>
  </view>
</view>
