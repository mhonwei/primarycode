/* 首页样式 */

.container {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #f3f4f6;
  border-radius: 40rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9ca3af;
  font-size: 26rpx;
}

/* 分类导航 */
.category-nav {
  white-space: nowrap;
  padding: 16rpx 24rpx;
}

.category-tab {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
}

.category-tab.active {
  background: #10b981;
  color: #ffffff;
  font-weight: 500;
}

/* 推荐卡片 */
.featured-card {
  margin: 20rpx 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 20rpx;
  color: #ffffff;
}

.featured-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.featured-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.featured-summary {
  font-size: 26rpx;
  opacity: 0.9;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.featured-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 16rpx;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 24rpx 12rpx;
  border-left: 6rpx solid #10b981;
  margin-left: 24rpx;
}

/* 文章卡片 */
.article-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.article-card .meta-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats {
  color: #10b981;
}
