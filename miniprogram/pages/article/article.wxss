/* 文章详情页样式 */

.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  margin: 20rpx 0;
  color: #1f2937;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  color: #9ca3af;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.tag {
  background: #f3f4f6;
  color: #6b7280;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.detail-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #374151;
}

/* 健康提示 */
.health-tips {
  margin-top: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 16rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #78350f;
  padding: 8rpx 0;
  line-height: 1.6;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e5e7eb;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: transparent;
  border: none;
  line-height: 1.4;
}

.action-btn::after {
  border: none;
}

.action-btn.liked {
  color: #ef4444;
}

.action-icon {
  font-size: 40rpx;
}

.share-btn {
  padding: 12rpx 24rpx;
}
