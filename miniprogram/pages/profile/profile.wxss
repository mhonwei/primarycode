/* 个人页面样式 */

.container {
  padding: 24rpx;
}

/* 用户卡片 */
.profile-card {
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 20rpx;
  padding: 48rpx;
  text-align: center;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.avatar {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 统计 */
.stats-row {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #10b981;
}

.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* 菜单 */
.menu-section {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.menu-title {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 20rpx 24rpx 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #9ca3af;
  font-size: 36rpx;
}

.font-controls {
  display: flex;
  gap: 12rpx;
}

.font-btn {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
}

.font-btn.active {
  background: #10b981;
  color: #ffffff;
}
