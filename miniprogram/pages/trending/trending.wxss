/* 热门页面样式 */

.article-card {
  display: flex;
  gap: 20rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.rank-badge {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #10b981;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.article-card:nth-child(1) .rank-badge { background: #ef4444; }
.article-card:nth-child(2) .rank-badge { background: #f97316; }
.article-card:nth-child(3) .rank-badge { background: #f59e0b; }

.article-info {
  flex: 1;
  min-width: 0;
}

.article-info .meta-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats {
  color: #10b981;
  font-size: 22rpx;
}
