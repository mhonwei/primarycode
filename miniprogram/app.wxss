/* 全局样式 - 健康资讯小程序 */

page {
  background-color: #f9fafb;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 大字号模式 */
.font-large {
  font-size: 32rpx;
}

.font-small {
  font-size: 24rpx;
}

/* 通用卡片样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 分类标签 */
.category-tag {
  display: inline-block;
  background: #d1fae5;
  color: #059669;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 文章标题 */
.article-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1f2937;
  margin: 12rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 文章摘要 */
.article-summary {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 元信息 */
.meta-info {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #9ca3af;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 26rpx;
}
